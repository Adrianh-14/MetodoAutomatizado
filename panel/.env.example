POSTGRES_USER=metodo
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=metodo_db

# Si la clave contiene caracteres reservados, codificala para una URL.
DATABASE_URL=postgresql://metodo:replace-with-a-long-random-password@postgres:5432/metodo_db?schema=public
DATABASE_URL_UNPOOLED=postgresql://metodo:replace-with-a-long-random-password@postgres:5432/metodo_db?schema=public

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

FRONTEND_URL=https://panel.example.com
AUTOMATION_API_KEY=replace-with-a-long-random-api-key

INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=replace-with-a-strong-admin-password
INITIAL_ADMIN_NAME=Administrador
SEED_DEMO_DATA=false
